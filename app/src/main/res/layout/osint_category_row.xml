<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#0A0A0A"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="#30363D"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/osint_cat_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="📧"
            android:textSize="28sp"
            android:background="#000000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osint_cat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL INTEL"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/osint_cat_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="desc"
                android:textColor="#8890A0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/osint_cat_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="▸ tool1"
                android:textColor="#7EE787"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❯"
            android:textColor="#A088F0"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
