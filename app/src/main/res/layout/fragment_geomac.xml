<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    tools:context=".geomac.GeoMac">

    <org.osmdroid.views.MapView
        android:id="@+id/geomap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pill aksi peta (fit/import/export/clear) SUDAH PINDAH ke dalam
         tumpukan bawah (baris geomac_action_row, batch temuan 2026-11-02):
         tidak ada lagi elemen mengambang di atas peta selain pill counter
         dan jendela trafik yang terdocking di atas tumpukan. -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/geomac_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="300dp"
        app:cardBackgroundColor="@color/osiris_panel_translucent"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/osiris_gold"
        app:strokeWidth="1dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/geomac_counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="0"
            android:textColor="#D4D4D4"
            android:textSize="11sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Jendela trafik (batch temuan 2026-11-02): BUKAN lagi kartu
         mengambang di tengah peta — ini jendela milik baris kategori
         TRAFIK di tumpukan bawah, terdocking di atas tumpukan (margin
         bawah diatur runtime oleh GeoMac.refreshBottomClearance).
         Tampil hanya saat TRAFFIC ON + jendela mengembang; X = ciutkan
         kembali ke baris (trafik tetap ON); toggle OFF di baris/sheet
         = hentikan trafik + sembunyikan jendela. Tidak ada lagi keadaan
         "bar ramping" atau tombol lipat: baris TRAFIK-lah bar rampingnya.
         Panel semi-transparan ala OSIRIS, border emas tetap solid.
         Margin bawah hanya fallback; nilai akhir diatur runtime. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/geomac_traffic_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="420dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/osiris_panel_translucent"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/osiris_gold"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <View
                android:id="@+id/geomac_traffic_handle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/traffic_handle"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/geomac_traffic_header"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/geomac_traffic_close_btn"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="5dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/close"
                    app:iconPadding="0dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/grey" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/geomac_traffic_rows_scroll"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/geomac_traffic_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/geomac_traffic_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/geomac_traffic_empty"
                android:textColor="@color/grey"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/geomac_sat_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="370dp"
        android:text="@string/geomac_sat_credit"
        android:textColor="@color/grey"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Tumpukan bawah Atlas (batch fix+atlas, gaya OSIRIS; diubah batch
         temuan 2026-11-02): satu kontainer vertikal supaya tinggi totalnya
         terukur runtime dan elemen overlay peta tidak pernah ketiban
         (lihat GeoMac.refreshBottomClearance). Dari atas ke bawah:
         kolom status, baris kategori TRAFIK (toggle + dot hidup + ketuk
         = buka jendela tabel), baris aksi peta (fit/import/export/clear,
         pindahan pill FAB mengambang), pill mode Jalan/Satelit (rata
         kiri, tombol dibangun di kode), pill tab SEARCH/LAYERS.
         Baris chips kategori SUDAH PINDAH ke dalam sheet SEARCH
         (GeoMacSearchSheet, seksi KATEGORI). Semua kartu panel di sini
         semi-transparan ala OSIRIS, border emas tetap solid. -->
    <LinearLayout
        android:id="@+id/geomac_bottom_stack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/geomac_busy"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="#D4AF37"
                    app:indicatorSize="22dp"
                    app:trackThickness="2dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/geomac_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/geomac_subtitle_idle"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/geomac_layer_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/geomac_layer_credit"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Baris kategori TRAFIK (batch temuan 2026-11-02): kategori
             permanen di tumpukan bawah, BUKAN kartu mengambang. Toggle =
             sumber kebenaran layerStore.TRAFFIC lewat jalur applyLayerToggle
             yang sama dengan toggle TRAFFIC di sheet Lapisan (keduanya
             sinkron, satu state). Dot hijau = trafik hidup. Ketuk baris
             (di luar toggle) saat ON = buka jendela tabel di atas tumpukan. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/geomac_traffic_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/osiris_panel_translucent"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/osiris_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/geomac_traffic_row_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/atlas_traffic_row"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/geomac_traffic_row_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/traffic_live_dot"
                    android:visibility="gone" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/geomac_traffic_row_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Baris aksi peta (batch temuan 2026-11-02): pindahan pill FAB
             mengambang (fit/import/export/clear) ke dalam tumpukan bawah.
             Tombol + handler SAMA PERSIS (GeoMac.wireActionBar); yang
             berubah hanya wadahnya (baris ramping di tumpukan, bukan pill
             melayang di tengah peta). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/geomac_action_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/osiris_panel_translucent"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/osiris_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/geomac_btn_fit"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="8dp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/expand_icon"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="#D4AF37" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/light_lite_contrast" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/geomac_btn_import"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="8dp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/download"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/grey" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/geomac_btn_export"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="8dp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/copy"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/grey" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/geomac_btn_clear"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="8dp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/delete"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/grey" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/geomac_mode_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/osiris_panel_translucent"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/osiris_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/geomac_mode_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/geomac_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/osiris_panel_translucent"
            app:cardCornerRadius="26dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/osiris_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/geomac_bar_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
