<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    tools:context=".geomac.GeoMac">

    <org.osmdroid.views.MapView
        android:id="@+id/geomap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Elemen mengambang di atas peta (batch BAR FINAL 2026-11-02):
         hanya pill counter yang tersisa — aksi pin pindah ke sheet
         pengaturan (tab gerigi), trafik jadi sheet dialog, panel RECON
         dihapus total, dan bar bawah kini 2 baris ramping (pill mode +
         tab bar). -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/geomac_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="300dp"
        app:cardBackgroundColor="@color/osiris_panel_translucent"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/osiris_gold"
        app:strokeWidth="1dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/geomac_counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="0"
            android:textColor="#D4D4D4"
            android:textSize="11sp" />
    </com.google.android.material.card.MaterialCardView>



    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/geomac_sat_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="370dp"
        android:text="@string/geomac_sat_credit"
        android:textColor="@color/grey"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Tumpukan bawah Atlas (batch BAR FINAL 2026-11-02, gaya OSIRIS):
         satu kontainer vertikal supaya tinggi totalnya terukur runtime
         dan elemen overlay peta tidak pernah ketiban (lihat
         GeoMac.refreshBottomClearance). Dari atas ke bawah: kolom status,
         pill mode (ikon saja, kartu sendiri, rata kiri), lalu tab bar
         (SATU pill: SEARCH/LAYERS/FIT/TRAFFIC/SETTING, ikon di atas +
         tulisan kecil caps di bawahnya). Baris chips kategori SUDAH
         PINDAH ke dalam sheet SEARCH (GeoMacSearchSheet, seksi KATEGORI);
         kartu trafik terdocking + panel RECON SUDAH DIHAPUS (trafik jadi
         sheet dialog, RECON dihapus total). Semua kartu di sini
         semi-transparan ala OSIRIS, border emas tetap solid. -->
    <LinearLayout
        android:id="@+id/geomac_bottom_stack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/geomac_busy"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="#D4AF37"
                    app:indicatorSize="22dp"
                    app:trackThickness="2dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/geomac_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/geomac_subtitle_idle"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/geomac_layer_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/geomac_layer_credit"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Pill mode Atlas (batch BAR FINAL 2026-11-02, gaya OSIRIS):
             pill terpisah di atas tab bar, IKON SAJA tanpa label (seperti
             pill mode di referensi) — ikon jalan + ikon satelit, aktif
             bingkai emas. Tombol dibangun di kode oleh AtlasModePill ke
             geomac_mode_buttons. Rata kiri (seperti referensi). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/geomac_mode_pill_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            app:cardBackgroundColor="@color/osiris_panel_translucent"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/osiris_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/geomac_mode_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Tab bar Atlas (batch BAR FINAL 2026-11-02, gaya OSIRIS):
             SATU pill berisi 5 tab — tiap tab = IKON di atas + TULISAN
             kecil caps di bawahnya, persis bar bawah referensi (bukan
             ikon saja). Tab dibangun di kode oleh AtlasBottomBar ke
             geomac_bar_tabs: SEARCH (sheet SEARCH) + LAYERS (sheet
             Lapisan) + FIT (aksi langsung) + TRAFFIC (sheet trafik) +
             SETTING (sheet pengaturan, gerigi). Tab RECON DIHAPUS. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/geomac_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/osiris_panel_translucent"
            app:cardCornerRadius="26dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/osiris_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/geomac_bar_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
