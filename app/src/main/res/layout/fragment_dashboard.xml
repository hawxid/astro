<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        tools:context=".MainActivity">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/magisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/dash_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/settings_icon_bg"
                        android:padding="7dp"
                        android:src="@drawable/magisk"
                        app:tint="#F57C00" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/dashboard_magisk_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/magisk_no"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/dashboard_magisk_dismiss"
                        android:textColor="@color/grey" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/magisk_yes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#F57C00"
                        android:text="@string/dashboard_magisk_silence"
                        android:textColor="@color/light_contrast"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/light_contrast"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_lite_contrast"
            app:strokeWidth="1dp">

            <id.hawx.astro.utils.AuroraView
                android:id="@+id/vm_aurora"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/vm_status_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <id.hawx.astro.utils.VmRingView
                        android:id="@+id/vm_ring"
                        android:layout_width="52dp"
                        android:layout_height="52dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/vm_card_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Linux engine"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/vm_status_badge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Stopped"
                            android:textColor="@color/grey"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/vm_specs_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="@color/grey"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vm_status_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▾"
                        android:textColor="@color/grey"
                        android:textSize="16sp" />
                </LinearLayout>

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/vm_status_expand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_expanded="true">

                    <LinearLayout
                        android:id="@+id/vm_controls_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/vm_btn_start"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Start"
                            android:textSize="12sp"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/vm_btn_stop"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Stop"
                            android:textSize="12sp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </net.cachapa.expandablelayout.ExpandableLayout>

                <View
                    android:id="@+id/vm_console_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/light_lite_contrast" />

                <LinearLayout
                    android:id="@+id/vm_stats_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/vm_section_stats"
                        android:src="@drawable/analytics"
                        app:tint="@color/grey" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/vm_section_stats"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vm_stats_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/vm_stat_placeholder"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vm_stats_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▸"
                        android:textColor="@color/grey"
                        android:textSize="16sp" />
                </LinearLayout>

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/vm_stats_expand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_expanded="false">

                    <LinearLayout
                        android:id="@+id/vm_stats_block"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.06"
                                android:text="@string/vm_stat_cpu"
                                android:textAllCaps="true"
                                android:textColor="@color/grey"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/vm_cpu_stat_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/vm_stat_placeholder"
                                android:textColor="@color/accent_vm"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <id.hawx.astro.utils.SparklineView
                            android:id="@+id/vm_cpu_stat_graph"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.06"
                                android:text="@string/vm_stat_ram"
                                android:textAllCaps="true"
                                android:textColor="@color/grey"
                                android:textSize="11sp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/vm_ram_stat_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/vm_stat_placeholder"
                                android:textColor="@color/green"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <id.hawx.astro.utils.SparklineView
                            android:id="@+id/vm_ram_stat_graph"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </net.cachapa.expandablelayout.ExpandableLayout>

                <View
                    android:id="@+id/vm_divider_usb"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/light_lite_contrast" />

                <LinearLayout
                    android:id="@+id/vm_usb_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/vm_section_usb"
                        android:src="@drawable/usb"
                        app:tint="@color/grey" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/vm_section_usb"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vm_usb_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/vm_usb_none"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vm_usb_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▸"
                        android:textColor="@color/grey"
                        android:textSize="16sp" />
                </LinearLayout>

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/vm_usb_expand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_expanded="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/vm_usb_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/vm_usb_none"
                            android:textColor="@color/grey"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/vm_usb_manage"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp"
                            android:minHeight="0dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/vm_usb_manage"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </net.cachapa.expandablelayout.ExpandableLayout>

                <View
                    android:id="@+id/vm_divider_logs"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/light_lite_contrast" />

                <LinearLayout
                    android:id="@+id/vm_logs_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/vm_section_logs"
                        android:src="@drawable/terminal"
                        app:tint="@color/grey" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/vm_section_logs"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/vm_logs_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▸"
                        android:textColor="@color/grey"
                        android:textSize="16sp" />
                </LinearLayout>

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/vm_logs_expand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_expanded="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:background="@drawable/terminal_bg"
                            android:descendantFocusability="blocksDescendants"
                            android:orientation="vertical">

                            <ScrollView
                                android:id="@+id/vm_log_scroll"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fillViewport="true"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                android:scrollbars="none">

                                <TextView
                                    android:id="@+id/vm_log_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:fontFamily="monospace"
                                    android:padding="12dp"
                                    android:textColor="#D7DAE0"
                                    android:textSize="11sp" />
                            </ScrollView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/vm_btn_refresh_log"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="Refresh"
                                android:textSize="12sp"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/vm_btn_copy_log"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/vm_log_copy"
                                android:textSize="12sp"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </net.cachapa.expandablelayout.ExpandableLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <WebView
            android:id="@+id/dash_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/DashboardSection"
            android:text="@string/dashboard_section_tools" />

        <LinearLayout
            android:id="@+id/tools_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dash_card_bg"
            android:orientation="vertical"
            android:padding="10dp" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/DashboardSection"
            android:text="@string/dashboard_section_recent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dash_card_bg"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/wifi_history"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/latest_wifi"
                    app:tint="@color/astro_accent" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/dashboard_card_saved_title" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/saved_count"
                    style="@style/DashboardRowCount"
                    android:text="0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recent_scan"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/latest_local"
                    app:tint="#AB47BC" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/dashboard_card_recentscan_title" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/recent_scan_count"
                    style="@style/DashboardRowCount"
                    android:text="0" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            style="@style/DashboardSection"
            android:text="@string/dashboard_section_more" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dash_card_bg"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/terminal"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/terminal"
                    app:tint="#5E35B1" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/dashboard_card_terminal_title" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dash_customize"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/tune"
                    app:tint="#00897B" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/dashboard_customize_title" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/news"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/notification"
                    app:tint="#EF6C00" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/dashboard_card_news_title" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dash_report"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/bug_report"
                    app:tint="#C62828" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/dashboard_report_title" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dash_unmount"
                style="@style/DashboardRow">

                <ImageView
                    style="@style/DashboardRowIcon"
                    android:src="@drawable/stop"
                    app:tint="#C62828" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DashboardRowTitle"
                    android:text="@string/settings_unmount_title" />

                <ImageView
                    style="@style/DashboardRowChevron"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/dash_github"
                    style="@style/DashboardSocial">

                    <ImageView
                        style="@style/DashboardSocialIcon"
                        android:src="@drawable/github" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DashboardSocialLabel"
                        android:text="@string/dashboard_social_github" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dash_site"
                    style="@style/DashboardSocial"
                    android:layout_marginStart="10dp">

                    <ImageView
                        style="@style/DashboardSocialIcon"
                        android:src="@drawable/web" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DashboardSocialLabel"
                        android:text="@string/dashboard_social_site" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/dash_blog"
                    style="@style/DashboardSocial">

                    <ImageView
                        style="@style/DashboardSocialIcon"
                        android:src="@drawable/telegram" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DashboardSocialLabel"
                        android:text="@string/dashboard_social_blog" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dash_chat"
                    style="@style/DashboardSocial"
                    android:layout_marginStart="10dp">

                    <ImageView
                        style="@style/DashboardSocialIcon"
                        android:src="@drawable/chat" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DashboardSocialLabel"
                        android:text="@string/dashboard_social_chat" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
