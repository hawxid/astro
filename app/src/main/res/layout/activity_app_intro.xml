<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".appintro.AppIntroActivity">

    <id.hawx.astro.appintro.IntroBackgroundView
        android:id="@+id/intro_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/intro_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="28dp"
        android:layout_marginTop="22dp"
        android:letterSpacing="0.01"
        android:text="@string/app_name"
        android:textColor="@color/intro_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/intro_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/intro_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/intro_primary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="120dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textAllCaps="false"
            android:textColor="@color/intro_button_text"
            android:textSize="15sp"
            app:backgroundTint="@color/intro_button_bg"
            app:cornerRadius="26dp"
            app:elevation="0dp" />
    </LinearLayout>
</FrameLayout>
