    <string name="usb_note_nodriver_title">No driver in Android</string>
    <string name="usb_note_nodriver_body">The phone\'s kernel has no module for this chipset, and one can\'t be added. Run Wi-Fi in a Linux guest that has it.</string>
    <string name="usb_note_setup_guest">Set up guest</string>

    <string name="usb_note_nonetdev_title">Driver bound, no interface</string>
    <string name="usb_note_nonetdev_body">%1$s attached to the adapter but never brought an interface up — usually firmware it couldn\'t find.</string>

    <string name="usb_note_guestdown_title">Guest isn\'t running</string>
    <string name="usb_note_guestdown_body">%1$s has to be up before the adapter can be handed to it.</string>

    <string name="usb_note_phoneholds_title">Android is using this adapter</string>
    <string name="usb_note_phoneholds_body">The phone\'s own %1$s driver has it. Stryker has to take it away from Android before %2$s can use it, and some kernels refuse — if the handover fails, this is why.</string>

    <string name="usb_note_noguestdriver_title">No driver in the guest</string>
    <string name="usb_note_noguestdriver_body">%1$s has no module for this chipset, so no interface came up.</string>
