<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="IntroEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/intro_chip_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/intro_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="IntroTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
        <item name="android:textColor">@color/intro_text</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="IntroSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">@color/intro_text_dim</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="IntroContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">bottom</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingBottom">104dp</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="IntroGhostButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/intro_text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>


    <style name="IntroConsentRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="IntroConsentBox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="buttonTint">@color/intro_dot_active</item>
    </style>

    <style name="IntroConsentText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/intro_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="IntroStatusRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="IntroStatusSpinner" parent="android:Widget.Material.ProgressBar.Small">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="IntroStatusIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="IntroStatusText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="IntroStatusName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/intro_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IntroStatusDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/intro_text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="IntroChoiceRow" parent="IntroStatusRow">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="IntroChoiceRadio" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:duplicateParentState">true</item>
        <item name="buttonTint">@color/intro_dot_active</item>
    </style>

    <style name="IntroChoiceHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="IntroChoiceBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/intro_chip_bg</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/intro_dot_active</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>
