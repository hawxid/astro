<resources>
    <style name="Theme.Astro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/astro_accent</item>
        <item name="colorPrimaryDark">?attr/colorSurface</item>
        <item name="colorPrimaryVariant">@color/astro_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/astro_accent</item>
        <item name="colorSecondaryVariant">@color/astro_accent_contrast</item>
        <item name="colorOnSecondary">@color/astro_accent_contrast</item>
        <item name="android:navigationBarColor">@color/toolbar_color</item>
        <item name="android:statusBarColor">@color/toolbar_color</item>
        <item name="switchStyle">@style/Widget.Astro.Switch</item>
        <item name="android:textViewStyle">@style/Widget.Astro.TextView</item>
        <item name="android:buttonStyle">@style/Widget.Astro.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Astro.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.Astro.FAB</item>
        <item name="materialAlertDialogTheme">@style/Widget.Astro.AlertDialog</item>
        <item name="backgroundColor">#070B16</item>
    </style>
    <style name="Theme.AstroFloatingDialog" parent="Theme.Astro">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Theme.Astro.Immersive" parent="Theme.Astro" />
</resources>