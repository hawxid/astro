<?xml version="1.0" encoding="utf-8"?>
<!-- Background dialog AlertDialog (batch gede 2026-11-01): panel gelap +
     outline emas OSIRIS yang terlihat jelas. Dipakai
     Widget.Astro.AlertDialog (semua AlertDialog aplikasi). -->
